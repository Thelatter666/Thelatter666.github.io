---
interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <style>
      /*
       * PDF 为浅色白底（spec §9.1）：
       * HR 会打印简历 —— 深色底在黑白打印机上是一片灰黑块，彩色打印也费墨，
       * 且深色简历在传统招聘流程中观感偏冒险。深色留给网站，PDF 走稳妥路线。
       */
      :root {
        --ink: #17211f;
        --body: #33413d;
        --muted: #66736e;
        --line: #d7dfdb;
        --accent: #176b58;
        --paper: #ffffff;
      }

      @page { size: A4; margin: 10mm; }

      * { box-sizing: border-box; }

      html, body { margin: 0; background: var(--paper); }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
                     "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
        font-size: 12px;
        line-height: 1.4;
        color: var(--body);
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      h1 { font-size: 26px; color: var(--ink); margin: 0; }
      h2 {
        font-size: 12.5px;
        color: var(--ink);
        letter-spacing: 0.08em;
        border-bottom: 1px solid var(--line);
        padding-bottom: 3px;
        margin: 13px 0 7px;
      }
      h3 { font-size: 12px; color: var(--ink); margin: 0; }
      p, li { font-size: 11.5px; line-height: 1.4; }
      a { color: var(--ink); text-decoration: none; }

      /* 条目与分节尽量不被分页切断 */
      .section { break-inside: avoid; }
      .entry { break-inside: avoid; margin-bottom: 7px; }

      /* 屏幕预览时的纸张效果；打印时由 @page 接管 */
      @media screen {
        body { background: #edf1ef; }
        .paper {
          width: 210mm;
          min-height: 297mm;
          margin: 20px auto;
          padding: 10mm;
          background: var(--paper);
          box-shadow: 0 2px 12px rgb(0 0 0 / 0.12);
        }
      }
    </style>
  </head>
  <body>
    <main class="paper">
      <slot />
    </main>
  </body>
</html>
