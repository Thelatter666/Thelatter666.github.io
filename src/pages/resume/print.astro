---
import PrintLayout from '../../layouts/PrintLayout.astro';
import { resume } from '../../data/resume';
import { site } from '../../data/site';
---

<PrintLayout title={`${resume.profile.name} · 简历`}>
  <header style="display:flex;justify-content:space-between;gap:20px;padding-bottom:6px;border-bottom:2px solid var(--ink);">
    <div>
      <h1>{resume.profile.name}</h1>
      <p style="margin:2px 0 0;color:var(--accent);font-weight:700;font-size:12px;">
        {resume.profile.role}
      </p>
    </div>
    <ul style="list-style:none;margin:0;padding:0;text-align:right;color:var(--muted);font-size:10.5px;line-height:1.5;">
      {
        resume.profile.contacts.map((c) => (
          <li><span style="display:inline-block;width:36px;">{c.label}</span>{c.value}</li>
        ))
      }
    </ul>
  </header>

  <section class="section">
    <h2>教育背景</h2>
    {
      resume.education.map((e) => (
        <div class="entry">
          <div style="display:flex;justify-content:space-between;gap:14px;">
            <h3>{e.school} <span style="color:var(--muted);font-weight:400;">{e.detail}</span></h3>
            <span style="color:var(--accent);font-weight:700;white-space:nowrap;">{e.period}</span>
          </div>
          <p style="margin:1px 0 0;">{e.note}</p>
        </div>
      ))
    }
  </section>

  <section class="section">
    <h2>专业技能</h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:7px 22px;">
      {
        resume.skills.map((s) => (
          <div class="entry">
            <h3>{s.title}</h3>
            <p style="margin:0;">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>核心项目经历</h2>
    {
      resume.projects.map((p) => (
        <div class="entry">
          <div style="display:flex;justify-content:space-between;gap:14px;">
            <h3>
              {p.name}
              <span style="color:var(--muted);font-weight:400;font-size:11.5px;">· {p.subtitle}</span>
            </h3>
            <span style="color:var(--accent);font-weight:700;white-space:nowrap;">{p.period}</span>
          </div>
          <ul style="margin:2px 0 0;padding-left:14px;">
            {p.highlights.map((h) => <li style="margin-bottom:1px;">{h}</li>)}
          </ul>
          <p style="margin:1px 0 0;font-size:10px;color:var(--muted);">{p.stack.join(' · ')}</p>
        </div>
      ))
    }
  </section>

  <section class="section">
    <h2>竞赛与荣誉</h2>
    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:3px 16px;">
      {resume.awards.map((a) => <li style="font-size:11.5px;">· {a}</li>)}
    </ul>
  </section>

  <footer style="display:flex;justify-content:space-between;margin-top:4px;padding-top:3px;border-top:1px solid var(--line);color:var(--muted);font-size:10px;">
    <span>{resume.footer.traits.join('　·　')}</span>
    <span>更新日期：{resume.footer.updatedAt}　·　{site.url.replace('https://', '')}</span>
  </footer>
</PrintLayout>
