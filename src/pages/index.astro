---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero3D from '../components/hero3d/Hero3D.astro';
import { site } from '../data/site';
---

<BaseLayout title={`${site.name} · ${site.role}`}>
  <section class="hero">
    <!--
      徽章带：上 55%。
      注意：Hero3D 是 Astro 组件，不能加 client:* 指令（那只作用于框架组件）。
      three 的分包靠组件内动态 import 实现 —— 效果等同，且不引入任何框架依赖。
    -->
    <div class="hero-visual"><Hero3D /></div>

    <!-- 文字带：下 45%。文本安全区 —— 徽章在几何上不可进入（spec §7.2） -->
    <div class="hero-text">
      <h1>{site.tagline}</h1>
      <p class="sub">新疆大学 软件工程 · 2027 届</p>
      <div class="cta">
        <a class="btn primary" href="/resume">查看简历</a>
        <a class="btn" href="/projects">我的项目</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100vh - var(--nav-height));
    display: grid;
    grid-template-rows: 55fr 45fr;   /* 徽章带 55% / 文字带 45%（spec §7.2） */
    align-items: center;
  }

  .hero-visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 320px;
  }

  .hero-text {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
    text-align: center;
  }

  .hero-text h1 {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    margin-bottom: var(--space-3);
  }

  .sub { color: var(--color-text-muted); }

  .cta {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    color: var(--color-text);
    font-size: var(--text-sm);
    transition: border-color var(--duration-base) var(--ease-out),
                background-color var(--duration-base) var(--ease-out);
  }
  .btn:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .btn.primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
  }
  .btn.primary:hover {
    background: var(--color-accent-dim);
    border-color: var(--color-accent-dim);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      grid-template-rows: 45fr 55fr;   /* 窄屏：徽章带收窄，文字为主 */
    }
    .hero-visual { min-height: 240px; }
  }
</style>
